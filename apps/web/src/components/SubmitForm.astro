---
import type { getTranslations } from "../lib/i18n";

interface Props {
  t: ReturnType<typeof getTranslations>;
}

const { t } = Astro.props;
---

<section id="submit" class="submit-section">
  <div class="shell">
    <div class="section-header">
      <div>
        <div class="eyebrow">{t.submit.eyebrow}</div>
        <h2>{t.submit.title}</h2>
      </div>
      <p class="section-desc">{t.submit.subtitle}</p>
    </div>

    <form id="mcp-submission-form" class="submission-card">
      <div class="form-grid">
        <div class="form-group">
          <label for="submitterName">{t.submit.form_name} *</label>
          <input type="text" id="submitterName" name="submitterName" required />
        </div>

        <div class="form-group">
          <label for="submitterEmail">{t.submit.form_email} *</label>
          <input type="email" id="submitterEmail" name="submitterEmail" required />
        </div>

        <div class="form-group">
          <label for="serverName">{t.submit.form_server_name} *</label>
          <input type="text" id="serverName" name="serverName" placeholder="e.g. Hadith Explorer MCP" required />
        </div>

        <div class="form-group">
          <label for="serverUrl">{t.submit.form_server_url} *</label>
          <input type="url" id="serverUrl" name="serverUrl" placeholder="https://example.com/mcp" required />
        </div>

        <div class="form-group full-width">
          <label for="category">{t.submit.form_category}</label>
          <select id="category" name="category">
            <option value="quran">{t.submit.cat_quran}</option>
            <option value="hadith">{t.submit.cat_hadith}</option>
            <option value="tafsir">{t.submit.cat_tafsir}</option>
            <option value="fiqh">{t.submit.cat_fiqh}</option>
            <option value="tools">{t.submit.cat_tools}</option>
          </select>
        </div>

        <div class="form-group full-width">
          <label for="description">{t.submit.form_desc}</label>
          <textarea
            id="description"
            name="description"
            rows="4"
            placeholder={t.submit.form_desc_placeholder}
          ></textarea>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" id="submit-btn" class="btn btn-primary">
          <span id="submit-text">{t.submit.form_submit}</span>
        </button>

        <div id="form-msg" class="form-feedback hidden" data-success-msg={t.submit.form_success} data-error-msg={t.submit.form_error} data-loading-msg={t.submit.form_submitting}></div>
      </div>
    </form>
  </div>
</section>

<script is:inline>
  const form = document.getElementById("mcp-submission-form");
  const msgEl = document.getElementById("form-msg");
  const submitBtn = document.getElementById("submit-btn");
  const submitText = document.getElementById("submit-text");

  if (form && msgEl && submitBtn && submitText) {
    const successMsg = msgEl.getAttribute("data-success-msg") || "Success!";
    const errorMsg = msgEl.getAttribute("data-error-msg") || "Error!";
    const loadingMsg = msgEl.getAttribute("data-loading-msg") || "Submitting...";
    const originalBtnText = submitText.textContent;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.setAttribute("disabled", "true");
      submitText.textContent = loadingMsg;
      msgEl.className = "form-feedback hidden";

      const formData = new FormData(form);
      const payload = {
        submitterName: formData.get("submitterName"),
        submitterEmail: formData.get("submitterEmail"),
        serverName: formData.get("serverName"),
        serverUrl: formData.get("serverUrl"),
        category: formData.get("category"),
        description: formData.get("description"),
      };

      try {
        const res = await fetch("/api/submissions", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          form.reset();
          msgEl.textContent = successMsg;
          msgEl.className = "form-feedback success";
        } else {
          msgEl.textContent = errorMsg;
          msgEl.className = "form-feedback error";
        }
      } catch (err) {
        msgEl.textContent = errorMsg;
        msgEl.className = "form-feedback error";
      } finally {
        submitBtn.removeAttribute("disabled");
        submitText.textContent = originalBtnText;
      }
    });
  }
</script>

<style>
  .submit-section {
    padding: 70px 0;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }

  h2 {
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.2;
    letter-spacing: -0.04em;
    font-weight: 800;
    margin: 8px 0 0;
    color: var(--ink);
  }

  .section-desc {
    max-width: 440px;
    color: var(--soft);
    font-size: 16px;
    margin: 0;
  }

  .submission-card {
    background: var(--paper);
    border: 1px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    padding: 32px;
    max-width: 860px;
    margin-inline: auto;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .full-width {
    grid-column: 1 / -1;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
  }

  input, select, textarea {
    font: inherit;
    font-size: 15px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--ink);
    border-radius: 2px;
  }

  input:focus, select:focus, textarea:focus {
    border-color: var(--tide);
    outline: 2px solid var(--lime);
  }

  .form-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 24px;
  }

  .form-feedback {
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 700;
    border-radius: 2px;
  }

  .form-feedback.success {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #86efac;
  }

  .form-feedback.error {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fca5a5;
  }

  .hidden {
    display: none;
  }

  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
