{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waqf-mcp-web",
  "account_id": "<CLOUDFLARE_ACCOUNT_ID>",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "observability": {
    "enabled": true
  }
}
