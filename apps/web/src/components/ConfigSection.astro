---
import { GATEWAY_MCP_URL, WEB_ASSISTANT_GUIDES, sectionNumber, type WebAssistantId } from "@waqf/types";
import type { getTranslations } from "../lib/i18n";
import CopyButton from "./CopyButton.astro";

interface Props {
  t: ReturnType<typeof getTranslations>;
}

const { t } = Astro.props;

const MCP_URL = GATEWAY_MCP_URL;

const WEB_SETUP_URLS: Record<string, string> = Object.fromEntries(
  WEB_ASSISTANT_GUIDES.map((guide) => [guide.id, guide.setUpUrl])
);

const WEB_CAVEATS: Record<string, string> = {
  claude_web: t.config.caveat_claude,
  chatgpt_web: t.config.caveat_chatgpt,
  gemini_web: t.config.caveat_gemini,
};

const GUIDE_LABELS: Record<WebAssistantId, string> = {
  claude_web: t.config.guide_claude,
  chatgpt_web: t.config.guide_chatgpt,
  gemini_web: t.config.guide_gemini,
};

const CLIENT_GUIDES = WEB_ASSISTANT_GUIDES.filter((guide) => guide.docsUrl !== null).map((guide) => ({
  id: guide.id,
  href: guide.docsUrl as string,
  label: GUIDE_LABELS[guide.id],
}));

const CLAUDE_CONFIG = JSON.stringify(
  {
    mcpServers: {
      "waqf-islamic-suite": {
        url: MCP_URL,
      },
    },
  },
  null,
  2
);

const CURSOR_CONFIG = JSON.stringify(
  {
    mcpServers: {
      "waqf-islamic-suite": {
        url: MCP_URL,
      },
    },
  },
  null,
  2
);

const ANTIGRAVITY_CONFIG = JSON.stringify(
  {
    mcpServers: {
      "waqf-islamic-suite": {
        url: MCP_URL,
      },
    },
  },
  null,
  2
);

const CLINE_CONFIG = JSON.stringify(
  {
    mcpServers: {
      "waqf-islamic-suite": {
        url: MCP_URL,
        disabled: false,
        autoApprove: [],
      },
    },
  },
  null,
  2
);

const CLAUDE_WEB_STEPS = t.config.claude_web_steps;
const CHATGPT_WEB_STEPS = t.config.chatgpt_web_steps;
const GEMINI_WEB_STEPS = t.config.gemini_web_steps;

const PYTHON_SNIPPET = `import httpx

# Cloudflare bot protection requires a custom User-Agent header
headers = {
    "User-Agent": "WaqfClient/1.0 (https://waqf.dev)",
    "Content-Type": "application/json",
}

# 1. Discover available tools (use ?suite=core for canonical tools)
tools_resp = httpx.post(
    "https://mcp.waqf.app/mcp?suite=core",
    json={"jsonrpc": "2.0", "id": 1, "method": "tools/list"},
    headers=headers,
)
print("Tools:", [t["name"] for t in tools_resp.json()["result"]["tools"]])

# 2. Call canonical Quran Ayah tool with automatic upstream fallback
payload = {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "tools/call",
    "params": {
        "name": "waqf_quran_get_ayah",
        "arguments": {"surah": 112, "ayah": 1}
    }
}
ayah_resp = httpx.post("https://mcp.waqf.app/mcp", json=payload, headers=headers)
print("Ayah Result:", ayah_resp.json()["result"]["content"][0]["text"])

# 3. Read Quran catalog resource (cached in Cloudflare D1)
res_resp = httpx.post(
    "https://mcp.waqf.app/mcp",
    json={"jsonrpc": "2.0", "id": 3, "method": "resources/read", "params": {"uri": "quran://surahs"}},
    headers=headers,
)
print("Surahs Catalog:", res_resp.json()["result"]["contents"][0]["text"][:100], "...")

# 4. Fetch structured Quran study prompt template
prompt_resp = httpx.post(
    "https://mcp.waqf.app/mcp",
    json={"jsonrpc": "2.0", "id": 4, "method": "prompts/get", "params": {"name": "study_ayah", "arguments": {"surah": "1", "ayah": "1"}}},
    headers=headers,
)
print("Study Prompt:", prompt_resp.json()["result"]["messages"][0]["content"]["text"][:100], "...")
`;

const TYPESCRIPT_SNIPPET = `import { Client } from "@modelcontextprotocol/sdk/client/index.js";
import { StreamableHttpClientTransport } from "@modelcontextprotocol/sdk/client/streamableHttp.js";

// Cloudflare WAF requires a custom User-Agent for programmatic clients
const transport = new StreamableHttpClientTransport(
  new URL("https://mcp.waqf.app/mcp?suite=core"),
  {
    headers: {
      "User-Agent": "WaqfClient/1.0 (https://waqf.dev)",
    },
  }
);

const client = new Client({ name: "waqf-app", version: "1.0.0" });
await client.connect(transport);

// 1. List available canonical tools
const { tools } = await client.listTools();
console.log("Federated Tools:", tools.map(t => t.name));

// 2. Call canonical Quran lookup with automatic fallback
const result = await client.callTool({
  name: "waqf_quran_get_ayah",
  arguments: { surah: 112, ayah: 1 },
});
console.log("Ayah Result:", (result.content[0] as { text: string }).text);

// 3. Read Quran catalog resource (cached in Cloudflare D1)
const { contents } = await client.readResource({ uri: "quran://surahs" });
console.log("Surahs Catalog:", (contents[0] as { text?: string }).text?.slice(0, 100));

// 4. Fetch structured Quran study prompt template
const prompt = await client.getPrompt({
  name: "study_ayah",
  arguments: { surah: "1", ayah: "1" },
});
console.log("Study Prompt Message:", prompt.messages[0]);
`;

const CURL_SNIPPET = `# 1. List canonical tools (saving tokens with ?suite=core)
curl -s -X POST "https://mcp.waqf.app/mcp?suite=core" \\
  -H "Content-Type: application/json" \\
  -H "User-Agent: WaqfClient/1.0" \\
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/list"}'

# 2. Call canonical Quran verse lookup (with automatic fallback)
curl -s -X POST "https://mcp.waqf.app/mcp" \\
  -H "Content-Type: application/json" \\
  -H "User-Agent: WaqfClient/1.0" \\
  -d '{
    "jsonrpc": "2.0",
    "id": 2,
    "method": "tools/call",
    "params": {
      "name": "waqf_quran_get_ayah",
      "arguments": { "surah": 112, "ayah": 1 }
    }
  }'

# 3. Read Quran catalog resource (cached in Cloudflare D1)
curl -s -X POST "https://mcp.waqf.app/mcp" \\
  -H "Content-Type: application/json" \\
  -H "User-Agent: WaqfClient/1.0" \\
  -d '{"jsonrpc":"2.0","id":3,"method":"resources/read","params":{"uri":"quran://surahs"}}'

# 4. Fetch structured Quran study prompt template
curl -s -X POST "https://mcp.waqf.app/mcp" \\
  -H "Content-Type: application/json" \\
  -H "User-Agent: WaqfClient/1.0" \\
  -d '{
    "jsonrpc": "2.0",
    "id": 4,
    "method": "prompts/get",
    "params": {
      "name": "study_ayah",
      "arguments": { "surah": "1", "ayah": "1" }
    }
  }'
`;
---

<section id="setup" class="config-section">
  <div class="shell">
    <div class="section-header">
      <div>
        <div class="eyebrow">{t.config.eyebrow} / {sectionNumber("config")}</div>
        <h2>{t.config.title}</h2>
      </div>
      <p class="section-desc">{t.config.subtitle}</p>
    </div>

    <div class="config-box">
      <!-- Category Switcher: Web Assistants vs IDEs vs Code SDKs -->
      <div class="group-switcher" role="tablist" aria-label={t.config.group_switcher_label}>
        <button
          id="group-tab-web"
          class="group-btn active"
          role="tab"
          aria-selected="true"
          aria-controls="web-guide-panel"
          data-group="web"
        >
          <span class="group-dot"></span>
          {t.config.group_web}
        </button>
        <button
          id="group-tab-ide"
          class="group-btn"
          role="tab"
          aria-selected="false"
          tabindex="-1"
          aria-controls="ide-code-panel"
          data-group="ide"
        >
          <span class="group-dot"></span>
          {t.config.group_ide}
        </button>
        <button
          id="group-tab-code"
          class="group-btn"
          role="tab"
          aria-selected="false"
          tabindex="-1"
          aria-controls="code-snippet-panel"
          data-group="code"
        >
          <span class="group-dot"></span>
          {t.config.group_code}
        </button>
      </div>

      <!-- Web Assistants Tabs -->
      <div id="web-tabs" class="tab-bar" role="tablist" aria-controls="web-guide-panel">
        <button
          id="web-tab-claude_web"
          class="tab-btn active"
          role="tab"
          aria-selected="true"
          data-tab="claude_web">{t.config.tab_claude_web}</button>
        <button
          id="web-tab-chatgpt_web"
          class="tab-btn"
          role="tab"
          aria-selected="false"
          tabindex="-1"
          data-tab="chatgpt_web">{t.config.tab_chatgpt_web}</button>
        <button
          id="web-tab-gemini_web"
          class="tab-btn"
          role="tab"
          aria-selected="false"
          tabindex="-1"
          data-tab="gemini_web">{t.config.tab_gemini_web}</button>
      </div>

      <!-- IDEs Tabs -->
      <div id="ide-tabs" class="tab-bar hidden" role="tablist" aria-controls="ide-code-panel">
        <button id="ide-tab-claude" class="tab-btn active" role="tab" aria-selected="true" data-tab="claude"
          >{t.config.tab_claude}</button>
        <button
          id="ide-tab-cursor"
          class="tab-btn"
          role="tab"
          aria-selected="false"
          tabindex="-1"
          data-tab="cursor">{t.config.tab_cursor}</button>
        <button
          id="ide-tab-antigravity"
          class="tab-btn"
          role="tab"
          aria-selected="false"
          tabindex="-1"
          data-tab="antigravity">{t.config.tab_antigravity}</button>
        <button
          id="ide-tab-cline"
          class="tab-btn"
          role="tab"
          aria-selected="false"
          tabindex="-1"
          data-tab="cline">{t.config.tab_cline}</button>
      </div>

      <!-- Code SDKs Tabs -->
      <div id="code-tabs" class="tab-bar hidden" role="tablist" aria-controls="code-snippet-panel">
        <button id="code-tab-python" class="tab-btn active" role="tab" aria-selected="true" data-tab="python"
          >{t.config.tab_python}</button>
        <button
          id="code-tab-typescript"
          class="tab-btn"
          role="tab"
          aria-selected="false"
          tabindex="-1"
          data-tab="typescript">{t.config.tab_typescript}</button>
        <button
          id="code-tab-curl"
          class="tab-btn"
          role="tab"
          aria-selected="false"
          tabindex="-1"
          data-tab="curl">{t.config.tab_curl}</button>
      </div>

      <!-- Web Assistants Step-by-Step Panel -->
      <div id="web-guide-panel" class="web-guide-panel" role="tabpanel" aria-labelledby="group-tab-web">
        <div class="endpoint-url-bar">
          <div class="url-meta">
            <span class="url-label">{t.config.server_url_label}:</span>
            <code id="mcp-remote-url" class="url-code" dir="ltr">{MCP_URL}</code>
          </div>
          <div class="url-actions">
            <a
              id="open-setup-link"
              href={WEB_SETUP_URLS.claude_web}
              target="_blank"
              rel="noopener noreferrer"
              class="open-setup-btn"
            >
              {t.config.open_setup_page}
            </a>
            <CopyButton
              value={MCP_URL}
              label={t.config.copy_url_button}
              copiedLabel={t.config.copied_button}
              failedLabel={t.common.copy_failed}
            />
          </div>
        </div>

        <div class="steps-wrapper">
          <div class="steps-header">
            <span class="steps-icon">⚡</span>
            <strong>{t.config.web_guide_title}</strong>
          </div>
          <ol id="steps-list" class="steps-list">
            {CLAUDE_WEB_STEPS.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
          <p id="web-caveat" class="tab-caveat">{WEB_CAVEATS.claude_web}</p>
        </div>
      </div>

      <!-- Desktop/IDE JSON Code Panel -->
      <div id="ide-code-panel" class="code-container hidden" dir="ltr" role="tabpanel" aria-labelledby="group-tab-ide">
        <pre dir="ltr"><code id="config-code" dir="ltr">{CLAUDE_CONFIG}</code></pre>
        <div class="copy-slot">
          <CopyButton
            target="#config-code"
            label={t.config.copy_button}
            copiedLabel={t.config.copied_button}
            failedLabel={t.common.copy_failed}
          />
        </div>
      </div>

      <!-- Developer Code Snippet Panel -->
      <div id="code-snippet-panel" class="code-panel-wrapper hidden" role="tabpanel" aria-labelledby="group-tab-code">
        <div class="bot-notice-box">
          <div class="bot-notice-icon">🛡️</div>
          <div>
            <strong>{t.config.dev_notice_title}</strong>
            <p>{t.config.dev_notice_desc}</p>
          </div>
        </div>
        <div class="code-container" dir="ltr">
          <pre dir="ltr"><code id="dev-code" dir="ltr">{PYTHON_SNIPPET}</code></pre>
          <div class="copy-slot">
            <CopyButton
              target="#dev-code"
              label={t.config.copy_button}
              copiedLabel={t.config.copied_button}
              failedLabel={t.common.copy_failed}
            />
          </div>
        </div>
      </div>

      <div class="official-guides">
        <span class="guides-title">{t.config.guides_title}</span>
        {CLIENT_GUIDES.map((guide) => (
          <a href={guide.href} target="_blank" rel="noopener noreferrer" class="guide-link">
            {guide.label} ↗
          </a>
        ))}
      </div>

      <div class="config-footer">
        <span class="tip-icon">💡</span>
        <span>{t.config.config_note}</span>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ CLAUDE_CONFIG, CURSOR_CONFIG, ANTIGRAVITY_CONFIG, CLINE_CONFIG, CLAUDE_WEB_STEPS, CHATGPT_WEB_STEPS, GEMINI_WEB_STEPS, WEB_SETUP_URLS, WEB_CAVEATS, PYTHON_SNIPPET, TYPESCRIPT_SNIPPET, CURL_SNIPPET }}>
  const webSteps = {
    claude_web: CLAUDE_WEB_STEPS,
    chatgpt_web: CHATGPT_WEB_STEPS,
    gemini_web: GEMINI_WEB_STEPS,
  };

  const webSetupUrls = WEB_SETUP_URLS;
  const webCaveats = WEB_CAVEATS;

  // Accessible tabs: keep aria-selected/tabindex in sync and support arrow keys (mirrored in RTL).
  function syncTabState(container) {
    const tabs = Array.from(container.querySelectorAll('[role="tab"]'));
    tabs.forEach((tab) => {
      const isActive = tab.classList.contains("active");
      tab.setAttribute("aria-selected", isActive ? "true" : "false");
      tab.tabIndex = isActive ? 0 : -1;
    });
  }

  function enableArrowKeys(container) {
    container.addEventListener("keydown", (event) => {
      const tabs = Array.from(container.querySelectorAll('[role="tab"]'));
      const current = tabs.indexOf(document.activeElement);
      if (current === -1) return;

      const rtl = document.documentElement.dir === "rtl";
      const forward = rtl ? (current - 1 + tabs.length) % tabs.length : (current + 1) % tabs.length;
      const backward = rtl ? (current + 1) % tabs.length : (current - 1 + tabs.length) % tabs.length;

      let nextIndex = null;
      if (event.key === "ArrowRight") nextIndex = forward;
      else if (event.key === "ArrowLeft") nextIndex = backward;
      else if (event.key === "Home") nextIndex = 0;
      else if (event.key === "End") nextIndex = tabs.length - 1;
      if (nextIndex === null) return;

      event.preventDefault();
      tabs[nextIndex].focus();
      tabs[nextIndex].click();
    });
  }

  const ideConfigs = {
    claude: CLAUDE_CONFIG,
    cursor: CURSOR_CONFIG,
    antigravity: ANTIGRAVITY_CONFIG,
    cline: CLINE_CONFIG,
  };

  const codeSnippets = {
    python: PYTHON_SNIPPET,
    typescript: TYPESCRIPT_SNIPPET,
    curl: CURL_SNIPPET,
  };

  // Switch between Web, IDE, and Code groups
  const groupBtns = document.querySelectorAll(".group-btn");
  const webTabs = document.getElementById("web-tabs");
  const ideTabs = document.getElementById("ide-tabs");
  const codeTabs = document.getElementById("code-tabs");
  const webGuidePanel = document.getElementById("web-guide-panel");
  const ideCodePanel = document.getElementById("ide-code-panel");
  const codeSnippetPanel = document.getElementById("code-snippet-panel");

  groupBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      groupBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const group = btn.getAttribute("data-group");

      if (group === "web") {
        if (webTabs) webTabs.classList.remove("hidden");
        if (ideTabs) ideTabs.classList.add("hidden");
        if (codeTabs) codeTabs.classList.add("hidden");
        if (webGuidePanel) webGuidePanel.classList.remove("hidden");
        if (ideCodePanel) ideCodePanel.classList.add("hidden");
        if (codeSnippetPanel) codeSnippetPanel.classList.add("hidden");
      } else if (group === "ide") {
        if (webTabs) webTabs.classList.add("hidden");
        if (ideTabs) ideTabs.classList.remove("hidden");
        if (codeTabs) codeTabs.classList.add("hidden");
        if (webGuidePanel) webGuidePanel.classList.add("hidden");
        if (ideCodePanel) ideCodePanel.classList.remove("hidden");
        if (codeSnippetPanel) codeSnippetPanel.classList.add("hidden");
      } else if (group === "code") {
        if (webTabs) webTabs.classList.add("hidden");
        if (ideTabs) ideTabs.classList.add("hidden");
        if (codeTabs) codeTabs.classList.remove("hidden");
        if (webGuidePanel) webGuidePanel.classList.add("hidden");
        if (ideCodePanel) ideCodePanel.classList.add("hidden");
        if (codeSnippetPanel) codeSnippetPanel.classList.remove("hidden");
      }

      const groupSwitcher = btn.closest('[role="tablist"]');
      if (groupSwitcher) syncTabState(groupSwitcher);
    });
  });

  // Handle Web Assistant Tab switching
  const stepsList = document.getElementById("steps-list");
  const webCaveat = document.getElementById("web-caveat");
  if (webTabs) {
    webTabs.querySelectorAll(".tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        webTabs.querySelectorAll(".tab-btn").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const tab = btn.getAttribute("data-tab");
        const steps = webSteps[tab];

        const openSetupLink = document.getElementById("open-setup-link");
        if (openSetupLink && webSetupUrls[tab]) {
          openSetupLink.href = webSetupUrls[tab];
        }

        if (stepsList && steps && Array.isArray(steps)) {
          stepsList.innerHTML = "";
          steps.forEach((stepText) => {
            const li = document.createElement("li");
            li.textContent = stepText;
            stepsList.appendChild(li);
          });
        }

        if (webCaveat && webCaveats[tab]) {
          webCaveat.textContent = webCaveats[tab];
        }

        syncTabState(webTabs);
      });
    });
  }

  // Handle IDE Tab switching
  const codeEl = document.getElementById("config-code");
  if (ideTabs) {
    ideTabs.querySelectorAll(".tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        ideTabs.querySelectorAll(".tab-btn").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const tab = btn.getAttribute("data-tab");
        if (codeEl && ideConfigs[tab]) {
          codeEl.textContent = ideConfigs[tab];
        }
        syncTabState(ideTabs);
      });
    });
  }

  // Handle Code Snippets Tab switching
  const devCodeEl = document.getElementById("dev-code");
  if (codeTabs) {
    codeTabs.querySelectorAll(".tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        codeTabs.querySelectorAll(".tab-btn").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const tab = btn.getAttribute("data-tab");
        if (devCodeEl && codeSnippets[tab]) {
          devCodeEl.textContent = codeSnippets[tab];
        }
        syncTabState(codeTabs);
      });
    });
  }

  // Initialise tab state and keyboard support
  [document.querySelector(".group-switcher"), webTabs, ideTabs, codeTabs].forEach((container) => {
    if (!container) return;
    syncTabState(container);
    enableArrowKeys(container);
  });
</script>

<style>
  .config-section {
    padding: 70px 0;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }

  h2 {
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.2;
    letter-spacing: -0.04em;
    font-weight: 800;
    margin: 8px 0 0;
    color: var(--ink);
  }

  .section-desc {
    max-width: 440px;
    color: var(--soft);
    font-size: 16px;
    margin: 0;
  }

  .config-box {
    background: #081d28;
    border: 1px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
  }

  /* Group Switcher */
  .group-switcher {
    display: flex;
    flex-wrap: wrap;
    background: #05141c;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .group-btn {
    background: none;
    border: none;
    border-inline-end: 1px solid rgba(255, 255, 255, 0.1);
    color: #9cb5af;
    font: 800 15px "Tajawal", sans-serif;
    padding: 14px 24px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background 0.15s, color 0.15s;
  }

  .group-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4a6760;
  }

  .group-btn:hover {
    color: var(--white);
  }

  .group-btn.active {
    background: #0e2735;
    color: var(--lime);
  }

  .group-btn.active .group-dot {
    background: var(--lime);
    box-shadow: 0 0 8px var(--lime);
  }

  /* Sub Tabs */
  .tab-bar {
    display: flex;
    flex-wrap: wrap;
    background: #0e2735;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .tab-btn {
    background: none;
    border: none;
    border-inline-end: 1px solid rgba(255, 255, 255, 0.1);
    color: #a9bfbb;
    font: 700 14px "Tajawal", sans-serif;
    padding: 14px 20px;
    transition: background 0.15s, color 0.15s;
  }

  .tab-btn:hover {
    color: var(--white);
  }

  .tab-btn.active {
    background: #081d28;
    color: var(--lime);
    border-block-end: 2px solid var(--lime);
  }

  /* Web Guide Panel */
  .web-guide-panel {
    padding: 24px;
    color: var(--paper);
  }

  .endpoint-url-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
