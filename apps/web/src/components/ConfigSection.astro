---
import type { getTranslations } from "../lib/i18n";

interface Props {
  t: ReturnType<typeof getTranslations>;
}

const { t } = Astro.props;

const MCP_URL = "https://mcp.waqf.dev/mcp";

const CLAUDE_CONFIG = JSON.stringify(
  {
    mcpServers: {
      "waqf-islamic-suite": {
        url: MCP_URL,
      },
    },
  },
  null,
  2
);

const CURSOR_CONFIG = JSON.stringify(
  {
    mcpServers: {
      "waqf-islamic-suite": {
        url: MCP_URL,
      },
    },
  },
  null,
  2
);

const ANTIGRAVITY_CONFIG = JSON.stringify(
  {
    mcpServers: {
      "waqf-islamic-suite": {
        url: MCP_URL,
      },
    },
  },
  null,
  2
);

const CLINE_CONFIG = JSON.stringify(
  {
    mcpServers: {
      "waqf-islamic-suite": {
        url: MCP_URL,
        disabled: false,
        autoApprove: [],
      },
    },
  },
  null,
  2
);

const CLAUDE_WEB_STEPS = t.config.claude_web_steps;
const CHATGPT_WEB_STEPS = t.config.chatgpt_web_steps;
const GEMINI_WEB_STEPS = t.config.gemini_web_steps;

const PYTHON_SNIPPET = `import httpx

# Cloudflare bot protection requires a custom User-Agent header
headers = {
    "User-Agent": "WaqfClient/1.0 (https://waqf.dev)",
    "Content-Type": "application/json",
}

# 1. Discover available tools (use ?suite=core for canonical tools)
tools_resp = httpx.post(
    "https://mcp.waqf.dev/mcp?suite=core",
    json={"jsonrpc": "2.0", "id": 1, "method": "tools/list"},
    headers=headers,
)
print("Tools:", [t["name"] for t in tools_resp.json()["result"]["tools"]])

# 2. Call canonical Quran Ayah tool with automatic upstream fallback
payload = {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "tools/call",
    "params": {
        "name": "waqf_quran_get_ayah",
        "arguments": {"surah": 112, "ayah": 1}
    }
}
ayah_resp = httpx.post("https://mcp.waqf.dev/mcp", json=payload, headers=headers)
print("Ayah Result:", ayah_resp.json()["result"]["content"][0]["text"])

# 3. Read Quran catalog resource (cached in Cloudflare D1)
res_resp = httpx.post(
    "https://mcp.waqf.dev/mcp",
    json={"jsonrpc": "2.0", "id": 3, "method": "resources/read", "params": {"uri": "quran://surahs"}},
    headers=headers,
)
print("Surahs Catalog:", res_resp.json()["result"]["contents"][0]["text"][:100], "...")

# 4. Fetch structured Quran study prompt template
prompt_resp = httpx.post(
    "https://mcp.waqf.dev/mcp",
    json={"jsonrpc": "2.0", "id": 4, "method": "prompts/get", "params": {"name": "study_ayah", "arguments": {"surah": "1", "ayah": "1"}}},
    headers=headers,
)
print("Study Prompt:", prompt_resp.json()["result"]["messages"][0]["content"]["text"][:100], "...")
`;

const TYPESCRIPT_SNIPPET = `import { Client } from "@modelcontextprotocol/sdk/client/index.js";
import { StreamableHttpClientTransport } from "@modelcontextprotocol/sdk/client/streamableHttp.js";

// Cloudflare WAF requires a custom User-Agent for programmatic clients
const transport = new StreamableHttpClientTransport(
  new URL("https://mcp.waqf.dev/mcp?suite=core"),
  {
    headers: {
      "User-Agent": "WaqfClient/1.0 (https://waqf.dev)",
    },
  }
);

const client = new Client({ name: "waqf-app", version: "1.0.0" });
await client.connect(transport);

// 1. List available canonical tools
const { tools } = await client.listTools();
console.log("Federated Tools:", tools.map(t => t.name));

// 2. Call canonical Quran lookup with automatic fallback
const result = await client.callTool({
  name: "waqf_quran_get_ayah",
  arguments: { surah: 112, ayah: 1 },
});
console.log("Ayah Result:", (result.content[0] as { text: string }).text);

// 3. Read Quran catalog resource (cached in Cloudflare D1)
const { contents } = await client.readResource({ uri: "quran://surahs" });
console.log("Surahs Catalog:", (contents[0] as { text?: string }).text?.slice(0, 100));

// 4. Fetch structured Quran study prompt template
const prompt = await client.getPrompt({
  name: "study_ayah",
  arguments: { surah: "1", ayah: "1" },
});
console.log("Study Prompt Message:", prompt.messages[0]);
`;

const CURL_SNIPPET = `# 1. List canonical tools (saving tokens with ?suite=core)
curl -s -X POST "https://mcp.waqf.dev/mcp?suite=core" \\
  -H "Content-Type: application/json" \\
  -H "User-Agent: WaqfClient/1.0" \\
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/list"}'

# 2. Call canonical Quran verse lookup (with automatic fallback)
curl -s -X POST "https://mcp.waqf.dev/mcp" \\
  -H "Content-Type: application/json" \\
  -H "User-Agent: WaqfClient/1.0" \\
  -d '{
    "jsonrpc": "2.0",
    "id": 2,
    "method": "tools/call",
    "params": {
      "name": "waqf_quran_get_ayah",
      "arguments": { "surah": 112, "ayah": 1 }
    }
  }'

# 3. Read Quran catalog resource (cached in Cloudflare D1)
curl -s -X POST "https://mcp.waqf.dev/mcp" \\
  -H "Content-Type: application/json" \\
  -H "User-Agent: WaqfClient/1.0" \\
  -d '{"jsonrpc":"2.0","id":3,"method":"resources/read","params":{"uri":"quran://surahs"}}'

# 4. Fetch structured Quran study prompt template
curl -s -X POST "https://mcp.waqf.dev/mcp" \\
  -H "Content-Type: application/json" \\
  -H "User-Agent: WaqfClient/1.0" \\
  -d '{
    "jsonrpc": "2.0",
    "id": 4,
    "method": "prompts/get",
    "params": {
      "name": "study_ayah",
      "arguments": { "surah": "1", "ayah": "1" }
    }
  }'
`;
---

<section id="setup" class="config-section">
  <div class="shell">
    <div class="section-header">
      <div>
        <div class="eyebrow">{t.config.eyebrow}</div>
        <h2>{t.config.title}</h2>
      </div>
      <p class="section-desc">{t.config.subtitle}</p>
    </div>

    <div class="config-box">
      <!-- Category Switcher: Web Assistants vs IDEs vs Code SDKs -->
      <div class="group-switcher">
        <button class="group-btn active" data-group="web">
          <span class="group-dot"></span>
          {t.config.group_web}
        </button>
        <button class="group-btn" data-group="ide">
          <span class="group-dot"></span>
          {t.config.group_ide}
        </button>
        <button class="group-btn" data-group="code">
          <span class="group-dot"></span>
          {t.config.group_code}
        </button>
      </div>

      <!-- Web Assistants Tabs -->
      <div id="web-tabs" class="tab-bar">
        <button class="tab-btn active" data-tab="claude_web">{t.config.tab_claude_web}</button>
        <button class="tab-btn" data-tab="chatgpt_web">{t.config.tab_chatgpt_web}</button>
        <button class="tab-btn" data-tab="gemini_web">{t.config.tab_gemini_web}</button>
      </div>

      <!-- IDEs Tabs -->
      <div id="ide-tabs" class="tab-bar hidden">
        <button class="tab-btn active" data-tab="claude">{t.config.tab_claude}</button>
        <button class="tab-btn" data-tab="cursor">{t.config.tab_cursor}</button>
        <button class="tab-btn" data-tab="antigravity">{t.config.tab_antigravity}</button>
        <button class="tab-btn" data-tab="cline">{t.config.tab_cline}</button>
      </div>

      <!-- Code SDKs Tabs -->
      <div id="code-tabs" class="tab-bar hidden">
        <button class="tab-btn active" data-tab="python">{t.config.tab_python}</button>
        <button class="tab-btn" data-tab="typescript">{t.config.tab_typescript}</button>
        <button class="tab-btn" data-tab="curl">{t.config.tab_curl}</button>
      </div>

      <!-- Web Assistants Step-by-Step Panel -->
      <div id="web-guide-panel" class="web-guide-panel">
        <div class="endpoint-url-bar">
          <div class="url-meta">
            <span class="url-label">{t.config.server_url_label}:</span>
            <code id="mcp-remote-url" class="url-code" dir="ltr">{MCP_URL}</code>
          </div>
          <div class="url-actions">
            <a
              id="open-setup-link"
              href="https://claude.ai/new#customize/connectors"
              target="_blank"
              rel="noopener noreferrer"
              class="open-setup-btn"
            >
              {t.config.open_setup_page}
            </a>
            <button id="copy-url-btn" class="copy-url-btn" data-copied-text={t.config.copied_button}>
              <span id="copy-url-text">{t.config.copy_url_button}</span>
            </button>
          </div>
        </div>

        <div class="steps-wrapper">
          <div class="steps-header">
            <span class="steps-icon">⚡</span>
            <strong>{t.config.web_guide_title}</strong>
          </div>
          <ol id="steps-list" class="steps-list">
            {CLAUDE_WEB_STEPS.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </div>
      </div>

      <!-- Desktop/IDE JSON Code Panel -->
      <div id="ide-code-panel" class="code-container hidden" dir="ltr">
        <pre dir="ltr"><code id="config-code" dir="ltr">{CLAUDE_CONFIG}</code></pre>
        <button id="copy-btn" class="copy-action-btn" data-copied-text={t.config.copied_button}>
          <span id="copy-text">{t.config.copy_button}</span>
        </button>
      </div>

      <!-- Developer Code Snippet Panel -->
      <div id="code-snippet-panel" class="code-panel-wrapper hidden">
        <div class="bot-notice-box">
          <div class="bot-notice-icon">🛡️</div>
          <div>
            <strong>{t.config.dev_notice_title}</strong>
            <p>{t.config.dev_notice_desc}</p>
          </div>
        </div>
        <div class="code-container" dir="ltr">
          <pre dir="ltr"><code id="dev-code" dir="ltr">{PYTHON_SNIPPET}</code></pre>
          <button id="dev-copy-btn" class="copy-action-btn" data-copied-text={t.config.copied_button}>
            <span id="dev-copy-text">{t.config.copy_button}</span>
          </button>
        </div>
      </div>

      <div class="config-footer">
        <span class="tip-icon">💡</span>
        <span>{t.config.config_note}</span>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ CLAUDE_CONFIG, CURSOR_CONFIG, ANTIGRAVITY_CONFIG, CLINE_CONFIG, CLAUDE_WEB_STEPS, CHATGPT_WEB_STEPS, GEMINI_WEB_STEPS, MCP_URL, PYTHON_SNIPPET, TYPESCRIPT_SNIPPET, CURL_SNIPPET }}>
  const webSteps = {
    claude_web: CLAUDE_WEB_STEPS,
    chatgpt_web: CHATGPT_WEB_STEPS,
    gemini_web: GEMINI_WEB_STEPS,
  };

  const webSetupUrls = {
    claude_web: "https://claude.ai/new#customize/connectors",
    chatgpt_web: "https://chatgpt.com/plugins",
    gemini_web: "https://gemini.google.com/apps",
  };

  const ideConfigs = {
    claude: CLAUDE_CONFIG,
    cursor: CURSOR_CONFIG,
    antigravity: ANTIGRAVITY_CONFIG,
    cline: CLINE_CONFIG,
  };

  const codeSnippets = {
    python: PYTHON_SNIPPET,
    typescript: TYPESCRIPT_SNIPPET,
    curl: CURL_SNIPPET,
  };

  // Switch between Web, IDE, and Code groups
  const groupBtns = document.querySelectorAll(".group-btn");
  const webTabs = document.getElementById("web-tabs");
  const ideTabs = document.getElementById("ide-tabs");
  const codeTabs = document.getElementById("code-tabs");
  const webGuidePanel = document.getElementById("web-guide-panel");
  const ideCodePanel = document.getElementById("ide-code-panel");
  const codeSnippetPanel = document.getElementById("code-snippet-panel");

  groupBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      groupBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const group = btn.getAttribute("data-group");

      if (group === "web") {
        if (webTabs) webTabs.classList.remove("hidden");
        if (ideTabs) ideTabs.classList.add("hidden");
        if (codeTabs) codeTabs.classList.add("hidden");
        if (webGuidePanel) webGuidePanel.classList.remove("hidden");
        if (ideCodePanel) ideCodePanel.classList.add("hidden");
        if (codeSnippetPanel) codeSnippetPanel.classList.add("hidden");
      } else if (group === "ide") {
        if (webTabs) webTabs.classList.add("hidden");
        if (ideTabs) ideTabs.classList.remove("hidden");
        if (codeTabs) codeTabs.classList.add("hidden");
        if (webGuidePanel) webGuidePanel.classList.add("hidden");
        if (ideCodePanel) ideCodePanel.classList.remove("hidden");
        if (codeSnippetPanel) codeSnippetPanel.classList.add("hidden");
      } else if (group === "code") {
        if (webTabs) webTabs.classList.add("hidden");
        if (ideTabs) ideTabs.classList.add("hidden");
        if (codeTabs) codeTabs.classList.remove("hidden");
        if (webGuidePanel) webGuidePanel.classList.add("hidden");
        if (ideCodePanel) ideCodePanel.classList.add("hidden");
        if (codeSnippetPanel) codeSnippetPanel.classList.remove("hidden");
      }
    });
  });

  // Handle Web Assistant Tab switching
  const stepsList = document.getElementById("steps-list");
  if (webTabs) {
    webTabs.querySelectorAll(".tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        webTabs.querySelectorAll(".tab-btn").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const tab = btn.getAttribute("data-tab");
        const steps = webSteps[tab];

        const openSetupLink = document.getElementById("open-setup-link");
        if (openSetupLink && webSetupUrls[tab]) {
          openSetupLink.href = webSetupUrls[tab];
        }

        if (stepsList && steps && Array.isArray(steps)) {
          stepsList.innerHTML = "";
          steps.forEach((stepText) => {
            const li = document.createElement("li");
            li.textContent = stepText;
            stepsList.appendChild(li);
          });
        }
      });
    });
  }

  // Handle IDE Tab switching
  const codeEl = document.getElementById("config-code");
  if (ideTabs) {
    ideTabs.querySelectorAll(".tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        ideTabs.querySelectorAll(".tab-btn").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const tab = btn.getAttribute("data-tab");
        if (codeEl && ideConfigs[tab]) {
          codeEl.textContent = ideConfigs[tab];
        }
      });
    });
  }

  // Handle Code Snippets Tab switching
  const devCodeEl = document.getElementById("dev-code");
  if (codeTabs) {
    codeTabs.querySelectorAll(".tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        codeTabs.querySelectorAll(".tab-btn").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const tab = btn.getAttribute("data-tab");
        if (devCodeEl && codeSnippets[tab]) {
          devCodeEl.textContent = codeSnippets[tab];
        }
      });
    });
  }

  // Copy Remote URL button
  const copyUrlBtn = document.getElementById("copy-url-btn");
  const copyUrlText = document.getElementById("copy-url-text");
  const origUrlBtnText = copyUrlText ? copyUrlText.textContent : "Copy URL";
  const copiedUrlText = copyUrlBtn ? copyUrlBtn.getAttribute("data-copied-text") : "Copied!";

  if (copyUrlBtn) {
    copyUrlBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(MCP_URL);
        if (copyUrlText) copyUrlText.textContent = copiedUrlText;
        copyUrlBtn.classList.add("copied");
        setTimeout(() => {
          if (copyUrlText) copyUrlText.textContent = origUrlBtnText;
          copyUrlBtn.classList.remove("copied");
        }, 2000);
      } catch (err) {
        console.error("Clipboard write error:", err);
      }
    });
  }

  // Copy IDE Config button
  const copyBtn = document.getElementById("copy-btn");
  const copyText = document.getElementById("copy-text");
  const originalText = copyText ? copyText.textContent : "Copy";
  const copiedText = copyBtn ? copyBtn.getAttribute("data-copied-text") : "Copied!";

  if (copyBtn && codeEl) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(codeEl.textContent);
        if (copyText) copyText.textContent = copiedText;
        copyBtn.classList.add("copied");
        setTimeout(() => {
          if (copyText) copyText.textContent = originalText;
          copyBtn.classList.remove("copied");
        }, 2000);
      } catch (err) {
        console.error("Clipboard write error:", err);
      }
    });
  }

  // Copy Dev Code Snippet button
  const devCopyBtn = document.getElementById("dev-copy-btn");
  const devCopyText = document.getElementById("dev-copy-text");
  const origDevCopyText = devCopyText ? devCopyText.textContent : "Copy";
  const copiedDevText = devCopyBtn ? devCopyBtn.getAttribute("data-copied-text") : "Copied!";

  if (devCopyBtn && devCodeEl) {
    devCopyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(devCodeEl.textContent);
        if (devCopyText) devCopyText.textContent = copiedDevText;
        devCopyBtn.classList.add("copied");
        setTimeout(() => {
          if (devCopyText) devCopyText.textContent = origDevCopyText;
          devCopyBtn.classList.remove("copied");
        }, 2000);
      } catch (err) {
        console.error("Clipboard write error:", err);
      }
    });
  }
</script>

<style>
  .config-section {
    padding: 70px 0;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }

  h2 {
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.2;
    letter-spacing: -0.04em;
    font-weight: 800;
    margin: 8px 0 0;
    color: var(--ink);
  }

  .section-desc {
    max-width: 440px;
    color: var(--soft);
    font-size: 16px;
    margin: 0;
  }

  .config-box {
    background: #081d28;
    border: 1px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
  }

  /* Group Switcher */
  .group-switcher {
    display: flex;
    background: #05141c;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .group-btn {
    background: none;
    border: none;
    border-inline-end: 1px solid rgba(255, 255, 255, 0.1);
    color: #9cb5af;
    font: 800 15px "Tajawal", sans-serif;
    padding: 14px 24px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background 0.15s, color 0.15s;
  }

  .group-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4a6760;
  }

  .group-btn:hover {
    color: var(--white);
  }

  .group-btn.active {
    background: #0e2735;
    color: var(--lime);
  }

  .group-btn.active .group-dot {
    background: var(--lime);
    box-shadow: 0 0 8px var(--lime);
  }

  /* Sub Tabs */
  .tab-bar {
    display: flex;
    flex-wrap: wrap;
    background: #0e2735;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .tab-btn {
    background: none;
    border: none;
    border-inline-end: 1px solid rgba(255, 255, 255, 0.1);
    color: #a9bfbb;
    font: 700 14px "Tajawal", sans-serif;
    padding: 14px 20px;
    transition: background 0.15s, color 0.15s;
  }

  .tab-btn:hover {
    color: var(--white);
  }

  .tab-btn.active {
    background: #081d28;
    color: var(--lime);
    border-block-end: 2px solid var(--lime);
  }

  /* Web Guide Panel */
  .web-guide-panel {
    padding: 24px;
    color: var(--paper);
  }

  .endpoint-url-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    background: #0c2432;
    border: 1px solid rgba(198, 238, 103, 0.3);
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .url-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .url-label {
    font-size: 13px;
    font-weight: 700;
    color: #9cb5af;
  }

  .url-code {
    font-family: var(--mono);
    font-size: 15px;
    color: var(--lime);
    background: #06161f;
    padding: 4px 10px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    direction: ltr !important;
    unicode-bidi: isolate;
  }

  .url-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .open-setup-btn {
    background: transparent;
    color: var(--lime);
    border: 1px solid var(--lime);
    padding: 8px 16px;
    font: 700 13px "Tajawal", sans-serif;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background 0.15s, color 0.15s, transform 0.15s;
  }

  .open-setup-btn:hover {
    background: rgba(198, 238, 103, 0.15);
    transform: translateY(-2px);
    color: var(--white);
  }

  .copy-url-btn {
    background: var(--lime);
    color: var(--ink);
    border: 1px solid var(--ink);
    padding: 8px 16px;
    font: 700 13px "Tajawal", sans-serif;
    box-shadow: 2px 2px 0 var(--tide);
    transition: transform 0.15s;
  }

  .copy-url-btn:hover {
    transform: translateY(-2px);
  }

  .copy-url-btn.copied {
    background: var(--tide);
    color: var(--white);
  }

  .steps-wrapper {
    background: #05141c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 20px 24px;
  }

  .steps-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 15px;
    color: var(--white);
  }

  .steps-icon {
    color: var(--lime);
  }

  .steps-list {
    margin: 0;
    padding-inline-start: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
    line-height: 1.7;
    color: #c9dbd6;
  }

  .steps-list li {
    padding-inline-start: 4px;
  }

  /* IDE Code Panel */
  .code-container {
    position: relative;
    padding: 24px;
    overflow-x: auto;
    direction: ltr !important;
    text-align: left !important;
  }

  pre {
    margin: 0;
    direction: ltr !important;
    text-align: left !important;
