{
  "name": "@waqf/mcp-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:api": "bash scripts/dev.sh api",
    "dev:web": "bash scripts/dev.sh web",
    "build": "aube -F @waqf/web run build",
    "deploy": "aube -F @waqf/api run deploy && aube -F @waqf/web run deploy",
    "deploy:api": "aube -F @waqf/api run deploy",
    "deploy:web": "aube -F @waqf/web run deploy",
    "typecheck": "aube run --recursive typecheck",
    "test": "aube -F @waqf/api run test",
    "tail": "bash scripts/tail-all.sh",
    "tail:debug": "bash scripts/tail-all.sh --debug",
    "tail:errors": "bash scripts/tail-all.sh --status-only"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "packageManager": "aube@latest"
}
