---
import { getTranslations, getDir, LOCALES, type SupportedLocale } from "../lib/i18n";

interface Props {
  lang?: string;
}

const { lang = "ar" } = Astro.props;
const t = getTranslations(lang);
const dir = getDir(lang);

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" type="image/svg+xml" href="/waqftech-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <style is:inline>
      :root {
        --ink: #112b38;
        --soft: #264655;
        --paper: #eef5f2;
        --mist: #dbe9e4;
        --line: #b9cec7;
        --tide: #2e7d76;
        --lime: #c6ee67;
        --clay: #e6a37a;
        --white: #fbfdfc;
        --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font: 17px/1.7 "Tajawal", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        font: inherit;
        cursor: pointer;
      }

      :focus-visible {
        outline: 3px solid var(--clay);
        outline-offset: 4px;
      }

      .shell {
        width: min(1180px, calc(100% - 40px));
        margin-inline: auto;
      }

      /* Announcement */
      .announcement {
        background: var(--lime);
        border-bottom: 1px solid #92ac50;
        font-size: 13px;
        font-weight: 700;
        text-align: center;
        padding: 8px 16px;
        color: var(--ink);
      }

      /* Topbar */
      header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(238, 245, 242, 0.94);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }

      .topbar {
        height: 74px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 21px;
        font-weight: 800;
        letter-spacing: -0.04em;
        color: var(--ink);
      }

      .brand svg, .brand img {
        width: 36px;
        height: 36px;
      }

      nav {
        display: flex;
        align-items: center;
        gap: 22px;
      }

      nav a {
        color: var(--soft);
        font-size: 15px;
        font-weight: 700;
        transition: color 0.15s;
      }

      nav a:hover {
        color: var(--tide);
      }

      .nav-cta {
        background: var(--ink);
        color: var(--white) !important;
        padding: 9px 18px;
        border-radius: 2px;
        box-shadow: 3px 3px 0 var(--tide);
        transition: transform 0.15s, box-shadow 0.15s;
      }

      .nav-cta:hover {
        transform: translateY(-2px);
        box-shadow: 4px 4px 0 var(--tide);
      }

      /* Language Selector */
      .lang-switcher {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        background: var(--white);
        border: 1px solid var(--line);
        font-size: 13px;
        font-weight: 700;
      }

      .lang-switcher a {
        color: var(--soft);
        padding: 2px 6px;
      }

      .lang-switcher a.active {
        background: var(--ink);
        color: var(--lime);
      }

      /* Brutalist Buttons & Elements */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 48px;
        padding: 11px 24px;
        border: 1px solid var(--ink);
        font-weight: 800;
        font-size: 15px;
        transition: transform 0.15s, box-shadow 0.15s;
      }

      .btn:hover {
        transform: translateY(-2px);
      }

      .btn-primary {
        background: var(--ink);
        color: var(--white);
        box-shadow: 5px 5px 0 var(--tide);
      }

      .btn-secondary {
        background: var(--white);
        color: var(--ink);
        box-shadow: 5px 5px 0 var(--ink);
      }

      .eyebrow {
        color: var(--tide);
        font: 700 12px/1.2 var(--mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
      }

      .eyebrow::before {
        content: "";
        width: 24px;
        height: 2px;
        background: currentColor;
      }

      /* Footer */
      footer {
        padding: 50px 0 25px;
        background: #081d28;
        color: var(--paper);
        border-top: 1px solid var(--line);
      }

      .footer-grid {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        padding-bottom: 25px;
        border-bottom: 1px solid rgba(238, 245, 242, 0.15);
      }

      .footer-bottom {
        display: flex;
        justify-content: space-between;
        padding-top: 18px;
        font: 12px var(--mono);
        color: #a9bfbb;
      }

      @media (max-width: 768px) {
        nav {
          display: none;
        }
        .footer-grid {
          flex-direction: column;
          align-items: flex-start;
        }
        .footer-bottom {
          flex-direction: column;
          gap: 8px;
        }
      }
    </style>
  </head>
  <body>
    <div class="announcement">
      <div class="shell">{t.announcement.text}</div>
    </div>

    <header>
      <div class="shell topbar">
        <a class="brand" href={lang === "ar" ? "/" : `/${lang}`}>
          <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="4" fill="#112B38" />
            <path d="M12 28L20 12L28 28" stroke="#C6EE67" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M15 23H25" stroke="#C6EE67" stroke-width="3" stroke-linecap="round" />
            <circle cx="20" cy="18" r="2" fill="#2E7D76" />
          </svg>
          <span>{t.nav.brand}</span>
        </a>

        <nav>
          <a href="#servers">{t.nav.servers}</a>
          <a href="#setup">{t.nav.setup}</a>
          <a href="#submit">{t.nav.submit}</a>
          <a href="#faq">FAQ</a>
          <a class="nav-cta" href="#setup">{t.hero.cta_copy}</a>

          <div class="lang-switcher">
            {Object.entries(LOCALES).map(([code, config]) => {
              const targetUrl = code === "ar" ? "/" : `/${code}`;
              const isActive = code === lang;
              return (
                <a href={targetUrl} class={isActive ? "active" : ""} title={config.name}>
                  {code.toUpperCase()}
                </a>
              );
            })}
          </div>
        </nav>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer>
      <div class="shell">
        <div class="footer-grid">
          <div>
            <div class="brand" style="color: var(--white);">
              <span>{t.nav.brand}</span>
            </div>
            <p style="color: #a9bfbb; font-size: 14px; max-width: 440px; margin: 8px 0 0;">
              {t.footer.brand_desc}
            </p>
          </div>

          <div style="font-size: 14px; color: #cbd9d5;">
            <a href="https://dev.waqftech.org" target="_blank" style="margin-inline-end: 18px; text-decoration: underline;">
              WaqfTech.org ↗
            </a>
            <a href="https://github.com/waqftech" target="_blank" style="text-decoration: underline;">
              GitHub ↗
            </a>
          </div>
        </div>

        <div class="footer-bottom">
          <span>{t.footer.rights}</span>
          <span>{t.footer.made_for}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
