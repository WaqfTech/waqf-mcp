---
import { formatToolsCount, type getTranslations } from "../lib/i18n";

interface Props {
  t: ReturnType<typeof getTranslations>;
  lang?: string;
}

const { t, lang = "ar" } = Astro.props;
const isArabic = lang === "ar";

const SERVERS = [
  {
    id: "tafsir_net" as const,
    url: "https://mcp.tafsir.net/mcp",
    toolsCount: 17,
    category: "quran",
    tools: [
      "fetch_ayah",
      "fetch_tafsir",
      "list_tafsir_sources",
      "get_qeraat_variants",
      "analyze_word",
      "find_root_occurrences",
      "get_root_stats",
    ],
    resources: [
      "quran://surahs",
      "quran://tafsirs",
      "quran://sciences",
      "quran://schema",
    ],
    prompts: [
      "study_ayah",
      "compare_tafsirs",
      "root_study",
      "surah_overview",
      "tajweed_lesson",
    ],
  },
  {
    id: "bahouth" as const,
    url: "https://bahouth.tafsir.net/mcp",
    toolsCount: 9,
    category: "quran",
    tools: ["get_verse", "list_surah_verses", "find_root", "list_verse_words", "list_verse_topics"],
  },
  {
    id: "turath" as const,
    url: "https://mcp.turath.io/mcp/",
    toolsCount: 5,
    category: "turath",
    tools: ["discover_turath", "search_turath", "get_book", "get_page", "get_author"],
  },
  {
    id: "maheralfahel" as const,
    url: "https://maheralfahel.net/mcp/",
    toolsCount: 5,
    category: "turath",
    tools: ["list-books", "get-book", "list-media", "search-content", "get-site-info"],
  },
  {
    id: "fihris" as const,
    url: "https://search.waqf.app/",
    toolsCount: 2,
    category: "tools",
    tools: ["search_islamic_sources", "list_indexed_sources"],
  },
];
---

<section id="servers" class="servers-section">
  <div class="shell">
    <div class="section-header">
      <div>
        <div class="eyebrow">{t.servers.eyebrow}</div>
        <h2>{t.servers.title}</h2>
      </div>
      <p class="section-desc">{t.servers.subtitle}</p>
    </div>

    <div class="servers-grid">
      {SERVERS.map((server) => {
        const cardData = t.servers.cards[server.id];
        return (
          <article class="server-card">
            <div class="card-top">
              <div>
                <h3>{cardData.title}</h3>
                <span class="provider-pill">{cardData.subtitle}</span>
              </div>
              <div class="badge-group">
                <span class="status-badge">{t.servers.active_badge}</span>
                {server.resources && (
                  <span class="parity-badge">{t.servers.full_parity_badge}</span>
                )}
              </div>
            </div>

            <p class="server-desc">{cardData.desc}</p>

            <div class="preview-block">
              <span class="preview-label">{formatToolsCount(server.toolsCount, lang, t)}</span>
              <div class="chips-row">
                {server.tools.map((tool) => (
                  <code>{tool}</code>
                ))}
              </div>
            </div>

            {server.resources && (
              <div class="preview-block resources-block">
                <span class="preview-label">{t.servers.resources_count_label}</span>
                <div class="chips-row">
                  {server.resources.map((res) => (
                    <code class="resource-chip">{res}</code>
                  ))}
                </div>
              </div>
            )}

            {server.prompts && (
              <div class="preview-block prompts-block">
                <span class="preview-label">{t.servers.prompts_count_label}</span>
                <div class="chips-row">
                  {server.prompts.map((p) => (
                    <code class="prompt-chip">{p}</code>
                  ))}
                </div>
              </div>
            )}

            <div class="card-footer">
              <span class="category-tag">
                {server.category === "quran"
                  ? t.servers.filter_quran
                  : server.category === "turath"
                    ? t.servers.filter_turath
                    : t.submit.cat_tools}
              </span>
              <a href={server.url} target="_blank" rel="noopener noreferrer" class="source-link">
                {t.servers.view_source} ↗
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .servers-section {
    padding: 70px 0;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  h2 {
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.2;
    letter-spacing: -0.04em;
    font-weight: 800;
    margin: 8px 0 0;
    color: var(--ink);
  }

  .section-desc {
    max-width: 440px;
    color: var(--soft);
    font-size: 16px;
    margin: 0;
  }

  .servers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .server-card {
    background: var(--paper);
    border: 1px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.15s;
  }

  .server-card:hover {
    transform: translateY(-2px);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
  }

  h3 {
    font-size: 20px;
    margin: 0 0 4px;
    font-weight: 800;
    color: var(--ink);
  }

  .provider-pill {
    font-size: 13px;
    color: var(--tide);
    font-weight: 700;
  }

  .badge-group {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .status-badge {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #86efac;
    font: 700 11px var(--mono);
    padding: 3px 8px;
    border-radius: 2px;
    white-space: nowrap;
  }

  .parity-badge {
    background: #eef2ff;
    color: #4338ca;
    border: 1px solid #c7d2fe;
    font: 700 10px var(--mono);
    padding: 2px 6px;
    border-radius: 2px;
    white-space: nowrap;
  }

  .server-desc {
    font-size: 15px;
    color: var(--soft);
    line-height: 1.6;
    margin: 0 0 14px;
  }

  .preview-block {
    margin: 6px 0;
    padding: 10px 12px;
    background: var(--white);
    border: 1px solid var(--line);
  }

  .preview-label {
    display: block;
    font: 700 11px var(--mono);
    color: var(--tide);
    margin-bottom: 6px;
    text-transform: uppercase;
  }

  .chips-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chips-row code {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line);
    padding: 2px 6px;
    font-size: 11px;
    font-family: var(--mono);
    direction: ltr !important;
    unicode-bidi: isolate;
    display: inline-block;
  }

  .chips-row code.resource-chip {
    background: #f0fdf4;
    color: #166534;
    border-color: #bbf7d0;
  }

  .chips-row code.prompt-chip {
    background: #eff6ff;
    color: #1e40af;
    border-color: #bfdbfe;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 13px;
  }

  .category-tag {
    font: 700 11px var(--mono);
    color: var(--soft);
  }

  .source-link {
    font-weight: 800;
    color: var(--tide);
  }
</style>
